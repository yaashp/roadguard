# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# MongoDB (optional for the demo — the app runs on an in-memory mock
# data layer automatically if this is not set or the connection fails)
MONGODB_URI=mongodb://127.0.0.1:27017/roadguard

# Google Maps Platform — needed by the CLIENT (see client/.env.example)
# Enable these APIs in Google Cloud Console:
#   - Maps JavaScript API
#   - Directions API
#   - Places API
#   - Geocoding API
GOOGLE_MAPS_API_KEY=YOUR_API_KEY
