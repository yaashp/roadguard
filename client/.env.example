# Google Maps Platform key used by the client.
# Enable in Google Cloud Console: Maps JavaScript API, Directions API, Places API, Geocoding API
# Leave blank to run in Demo Map Mode (a fully interactive stylized fallback map — no key required).
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the RoadGuard API (Vite dev server proxies /api to this by default)
VITE_API_BASE_URL=/api
